# Copy sang .env va dien gia tri that. File nay KHONG chua secret.
# docker-compose.prod.yml doc toan bo bien duoi day (bare ${VAR}, khong co default).

### Database ###
DB_USER=postgres
DB_PASS=CHANGE_ME

### Messaging ###
RABBIT_USER=airline_app
RABBIT_PASS=CHANGE_ME
KAFKA_ADVERTISED_HOST=localhost

### Keycloak ###
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=airline-booking
VITE_KEYCLOAK_CLIENT_ID=airline-frontend

### Frontend / CORS ###
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

### Mail ###
MAIL_FROM=no-reply@example.com

### SePay ###
SEPAY_API_KEY=CHANGE_ME
SEPAY_ACC_HOLDER=NGUYEN VAN A
SEPAY_BANK_ACC=0123456789
SEPAY_BANK_CODE=MB
SEPAY_QR_BASE=https://qr.sepay.vn/img
SEPAY_QR_TEMPLATE=compact
SEPAY_EXPIRES_MIN=15

### Observability ###
GRAFANA_USER=admin
GRAFANA_PASS=CHANGE_ME
TRACING_ENABLED=true
