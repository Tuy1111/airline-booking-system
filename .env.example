# ==============================================================================
# Cấu hình cho docker-compose.prod.yml. Trên VPS: `cp .env.example .env` rồi điền.
# File .env đã được .gitignore -> KHÔNG commit secrets.
# Mọi biến đều có default trong compose, trừ SEPAY_* (payment cần để chạy thật).
# ==============================================================================

# --- Postgres (dùng chung cho cả 5 service) ---
DB_USER=abs
DB_PASS=abs123

# --- user-service JWT (HS256, PHẢI >= 32 ký tự khi chạy thật) ---
JWT_SECRET=change-me-to-a-long-random-32byte-secret-000
JWT_TTL_SECONDS=3600

# --- payment-service / SePay (BẮT BUỘC điền để tạo QR thanh toán) ---
SEPAY_API_KEY=
SEPAY_BANK_ACC=
SEPAY_BANK_CODE=
SEPAY_ACC_HOLDER=
# Optional (có default trong compose):
# SEPAY_QR_BASE=https://qr.sepay.vn/img
# SEPAY_QR_TEMPLATE=compact
# SEPAY_EXPIRES_MIN=15

# --- notification-service ---
MAIL_FROM=no-reply@airline.local
RABBIT_USER=guest
RABBIT_PASS=guest

# --- Observability (để false trừ khi bật profile monitoring) ---
TRACING_ENABLED=false

# --- Grafana (chỉ dùng khi --profile monitoring) ---
GRAFANA_USER=admin
GRAFANA_PASS=admin
