# ==============================================================================
# Airline Booking System — env mau (COMMIT file nay, KHONG commit .env)
#
#   cp .env.example .env      # roi dien cac gia tri CHANGE_ME
#
# .env o ROOT repo phuc vu 2 viec:
#   1. spring-dotenv  -> service doc config khi chay LOCAL (ngoai Docker)
#   2. docker compose -> thay bien ${...} trong docker-compose*.yml
#
# Trong Docker KHONG co file .env: compose tu inject env vao container.
#
# QUAN TRONG: application.yml dung ${VAR} thuan, KHONG default.
# Compose dung ${VAR:?...} -> thieu key la bao loi ngay, khong chay ngam.
#
# LUU Y CWD: spring-dotenv tim .env theo working directory cua tien trinh
# -> chay service voi CWD = root repo, neu khong se khong thay file nay.
# ==============================================================================

# ------------------------------------------------------------------ DATABASE -
# Stack Docker local (docker-compose.yml): localhost:5432
# Postgres tren VPS:                       143.198.213.125 / 5555
# Trong Docker prod compose tu override -> postgres:5432
DB_HOST=localhost
DB_PORT=5432
DB_USER=abs
DB_PASS=CHANGE_ME

# --------------------------------------------------------------------- REDIS -
# Chi booking-service dung. Docker override -> redis:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --------------------------------------------------------------------- KAFKA -
# booking / payment / notification. Docker override -> kafka:29092
KAFKA_BOOTSTRAP=localhost:9092
# Host ma Kafka quang ba cho client NGOAI docker network.
# Local de localhost; tren VPS phai doi thanh IP VPS.
KAFKA_ADVERTISED_HOST=localhost

# ---------------------------------------------------------------------- MAIL -
# Dev = MailHog (khong auth). UI: http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@airline.local

# ------------------------------------------------------------------ RABBITMQ -
# Vua tao user cho container rabbitmq, vua la creds notification-service connect.
# Mgmt UI: http://localhost:15672
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=abs
RABBIT_PASS=CHANGE_ME

# ---------------------------------------------------------------------- AUTH -
# user-service. HS256 -> BAT BUOC >= 32 bytes. Sinh: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_TTL_SECONDS=3600

# ------------------------------------------------------------- OBSERVABILITY -
TRACING_ENABLED=false
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# ---------------------------------------------------------- SERVICE DISCOVERY -
# Docker override qua EUREKA_CLIENT_SERVICEURL_DEFAULTZONE -> service-registry:8761
EUREKA_URL=http://localhost:8761/eureka

# --------------------------------------------------------------------- SEPAY -
# payment-service. Lay tu dashboard SePay.
SEPAY_API_KEY=CHANGE_ME
SEPAY_BANK_ACC=CHANGE_ME
SEPAY_BANK_CODE=CHANGE_ME
SEPAY_ACC_HOLDER=CHANGE_ME
SEPAY_QR_BASE=https://qr.sepay.vn/img
SEPAY_QR_TEMPLATE=compact
SEPAY_EXPIRES_MIN=15

# ------------------------------------------------------------------ KEYCLOAK -
# Admin console: http://localhost:8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------- PGADMIN -
# http://localhost:5050
PGADMIN_EMAIL=admin@abs.local
PGADMIN_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------- GRAFANA -
# http://localhost:3000 (profile monitoring)
GRAFANA_USER=admin
GRAFANA_PASS=CHANGE_ME

# ------------------------------------------------------------------ FRONTEND -
FRONTEND_PORT=80
