# ==============================================================================
# Env cho stack infra local:
#   docker compose -f infra/docker/docker-compose.yml up -d
#
# Compose doc .env NAM CANH file compose (tuc infra/docker/.env),
# KHONG phai .env o root repo. Day la 2 file rieng biet.
#
#   cp infra/docker/.env.example infra/docker/.env
# ==============================================================================

# Postgres (POSTGRES_USER / POSTGRES_PASSWORD cua container)
DB_USER=abs
DB_PASS=CHANGE_ME

# RabbitMQ (RABBITMQ_DEFAULT_USER / _PASS). Phai khop RABBIT_USER/RABBIT_PASS
# o .env root, vi notification-service dung creds do de connect.
RABBIT_USER=abs
RABBIT_PASS=CHANGE_ME

# Grafana admin — http://localhost:3000
GRAFANA_USER=admin
GRAFANA_PASS=CHANGE_ME
