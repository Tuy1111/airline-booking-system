{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "Airline Booking · Services Overview",
  "tags": ["airline-booking"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "application",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(jvm_memory_used_bytes, application)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Up",
      "datasource": "Prometheus",
      "targets": [{"expr": "up{application=~\"$application\"}", "legendFormat": "{{job}}"}],
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 4}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP requests / sec",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"$application\"}[1m]))",
        "legendFormat": "{{application}}"
      }],
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 HTTP latency (s)",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket{application=~\"$application\"}[5m])))",
        "legendFormat": "{{application}}"
      }],
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM heap used",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\", application=~\"$application\"})",
        "legendFormat": "{{application}}"
      }],
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Notifications dispatched",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum by (outcome, channel) (rate(notification_dispatched_total[1m]))",
        "legendFormat": "{{channel}} {{outcome}}"
      }],
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}
    }
  ]
}
