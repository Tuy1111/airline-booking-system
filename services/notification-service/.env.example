# ── notification-service · env template ──
# cp .env.example .env  (file .env đã gitignore)
# spring-dotenv tự nạp file này khi service khởi động.

# Database (notify_db)
DB_HOST=localhost
DB_PORT=5432
DB_USER=abs
DB_PASS=abs123

# Mail (MailHog dev: không cần auth)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@airline.local

# RabbitMQ (consume cmd.email.send / cmd.sms.send)
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASS=guest

# Kafka (consume booking.confirmed / booking.cancelled / payment.failed)
KAFKA_BOOTSTRAP=localhost:9092

# Tracing
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans
