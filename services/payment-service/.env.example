# ── payment-service · env template ──
# cp .env.example .env  (file .env đã gitignore)
# spring-dotenv tự nạp file này khi service khởi động.

# Database (payment_db)
DB_HOST=localhost
DB_PORT=5432
DB_USER=abs
DB_PASS=abs123

# Kafka (publish payment.completed / payment.failed)
KAFKA_BOOTSTRAP=localhost:9092

# Tracing
ZIPKIN_ENDPOINT=http://localhost:9411/api/v2/spans

# SePay — lấy trên https://my.sepay.vn → Cài đặt → API & Webhooks
SEPAY_API_KEY=changeme
SEPAY_BANK_ACC=0123456789
SEPAY_BANK_CODE=MBBank
SEPAY_ACC_HOLDER=AIRLINE BOOKING JSC
SEPAY_QR_BASE=https://qr.sepay.vn/img
SEPAY_QR_TEMPLATE=compact
SEPAY_EXPIRES_MIN=15
